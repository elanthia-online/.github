#!/usr/bin/env bash
# Apply the shared rulesets and repository settings to Elanthia Online repos.
#
#   bin/apply-rulesets [--dry-run] [--test-branch NAME] OWNER/REPO...
#
# Run by an admin (needs a gh token with admin rights on the repos) after a
# change to rulesets/ merges. Idempotent: rulesets are matched by name and
# updated in place, so running it twice changes nothing.
#
# For each repo it:
#   - creates or updates the "main" and "release tags" rulesets
#     (plus "pre/beta branches" on lich-5);
#   - sets squash-only merges and delete-branch-on-merge;
#   - sets the default workflow token to read-only and turns off
#     "Allow GitHub Actions to create and approve pull requests"
#     (left on for lich-5, whose release-please workflows open PRs).
#
# --test-branch NAME points the rulesets at scratch refs instead of the real
# ones, for trying them out on a fork: the default branch becomes NAME,
# pre/beta patterns become NAME-pre/beta..., release tags become vtest-*,
# and every ruleset name gets a "TEST " prefix.
set -euo pipefail

root=$(cd "$(dirname "$0")/.." && pwd)
dry=false
test_branch=""
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run) dry=true; shift ;;
    --test-branch) test_branch=$2; shift 2 ;;
    -h|--help) sed -n '2,24p' "$0"; exit 0 ;;
    -*) echo "unknown option: $1" >&2; exit 2 ;;
    *) break ;;
  esac
done
[ $# -gt 0 ] || { echo "usage: $0 [--dry-run] [--test-branch NAME] OWNER/REPO..." >&2; exit 2; }

write() { # write METHOD PATH [gh api args...]
  if $dry; then echo "  DRY-RUN: gh api -X $1 $2 ${*:3}"; cat > /dev/null; return 0; fi
  gh api -X "$1" "$2" "${@:3}" > /dev/null
}

ruleset_body() { # ruleset_body FILE
  if [ -z "$test_branch" ]; then cat "$1"; return; fi
  jq --arg b "$test_branch" '
    .name = "TEST " + .name
    | .conditions.ref_name.include |= map(
        if . == "~DEFAULT_BRANCH" then "refs/heads/" + $b
        elif startswith("refs/heads/") then "refs/heads/" + $b + "-" + .[11:]
        elif startswith("refs/tags/v") then "refs/tags/vtest-" + .[11:]
        else . end)' "$1"
}

apply_ruleset() { # apply_ruleset REPO FILE
  local repo=$1 body name id
  body=$(ruleset_body "$2")
  name=$(jq -r .name <<< "$body")
  id=$(gh api "repos/$repo/rulesets?includes_parents=false" --jq ".[] | select(.name == \"$name\") | .id")
  if [ -n "$id" ]; then
    echo "  updating ruleset \"$name\" ($id)"
    write PUT "repos/$repo/rulesets/$id" --input - <<< "$body"
  else
    echo "  creating ruleset \"$name\""
    write POST "repos/$repo/rulesets" --input - <<< "$body"
  fi
}

for repo in "$@"; do
  echo "$repo"
  name=${repo#*/}

  echo "  merge settings: squash only, delete branch on merge"
  write PATCH "repos/$repo" -F allow_squash_merge=true -F allow_merge_commit=false \
    -F allow_rebase_merge=false -F delete_branch_on_merge=true < /dev/null

  approve=false
  if [ "$name" = "lich-5" ]; then approve=true; fi
  echo "  workflow token: read-only; Actions may create/approve PRs: $approve"
  write PUT "repos/$repo/actions/permissions/workflow" -f default_workflow_permissions=read \
    -F can_approve_pull_request_reviews=$approve < /dev/null

  apply_ruleset "$repo" "$root/rulesets/main.json"
  apply_ruleset "$repo" "$root/rulesets/release-tags.json"
  if [ "$name" = "lich-5" ]; then apply_ruleset "$repo" "$root/rulesets/pre-beta.json"; fi
done
